exports[`IndicatorCatalog Component Snapshots SN-003: Loading state snapshot 1`] = `
<section
  aria-labelledby="catalog-title"
  data-loading="true"
  data-testid="indicator-catalog"
  role="region"
>
  <div
    data-testid="skeleton-title"
  >
    <div
      class="h-8 w-48"
      data-testid="skeleton"
    />
  </div>
  <div
    data-loading="true"
    data-testid="indicator-grid"
  >
    <div
      data-testid="skeleton-grid"
    >
      Loading...
    </div>
  </div>
</section>
`;

exports[`IndicatorCatalog Component Snapshots SN-004: Error state snapshot 1`] = `
<section
  aria-labelledby="catalog-title"
  aria-live="polite"
  data-error="true"
  data-testid="indicator-catalog"
  role="region"
>
  <div
    data-testid="error-container"
    role="alert"
  >
    <svg
      data-testid="alert-circle-icon"
    >
      AlertCircle
    </svg>
    <p
      data-testid="error-message"
    >
      Test error
    </p>
    <button
      aria-label="Retry loading indicators"
      data-testid="retry-button"
    >
      Try Again
    </button>
  </div>
</section>
`;

exports[`IndicatorCatalog Component Snapshots SN-005: Empty state snapshot 1`] = `
<section
  aria-labelledby="catalog-title"
