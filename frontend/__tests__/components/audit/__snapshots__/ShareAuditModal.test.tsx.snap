exports[`ShareAuditModal Component Snapshots matches snapshot for public audit 1`] = `
<div
  aria-labelledby="modal-title"
  aria-modal="true"
  data-testid="share-audit-modal"
  role="dialog"
>
  <div
    data-testid="modal-header"
  >
    <h2
      id="modal-title"
    >
      Share Audit
    </h2>
    <button
      aria-label="Close dialog"
      data-testid="close-button"
    >
      ×
    </button>
  </div>
  <div
    data-testid="modal-content"
  >
    <div
      data-testid="audit-info"
    >
      <span
        data-testid="audit-url"
      >
        example.com
      </span>
      <span
        data-testid="audit-score"
      >
        Score: 
        85
        /100
      </span>
    </div>
    <div
      data-testid="visibility-section"
    >
      <span
        aria-live="polite"
        data-testid="visibility-status"
      >
        Public
      </span>
      <button
        aria-checked="true"
        aria-label="Toggle public visibility"
        data-testid="visibility-toggle"
        role="switch"
      >
        ON
      </button>
    </div>
    <div
      data-testid="public-url-section"
    >
      <input
        aria-label="Public audit URL"
        data-testid="public-url-input"
        readonly=""
        type="text"
        value="http://localhost/audit/abc123def4567890123456789012"
      />
      <button
        aria-label="Copy public URL"
        data-testid="copy-url-button"
      >
        Copy
      </button>
    </div>
  </div>
  <div
    data-testid="modal-footer"
  >
    <button
      data-testid="cancel-button"
    >
      Cancel
    </button>
  </div>
</div>
`;
