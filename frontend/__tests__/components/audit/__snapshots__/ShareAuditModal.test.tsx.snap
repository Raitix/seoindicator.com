exports[`ShareAuditModal Component Snapshots matches snapshot for loading state 1`] = `
<div
  aria-labelledby="modal-title"
  aria-modal="true"
  data-testid="share-audit-modal"
  role="dialog"
>
  <div
    data-testid="modal-header"
  >
    <h2
      id="modal-title"
    >
      Share Audit
    </h2>
    <button
      aria-label="Close dialog"
      data-testid="close-button"
    >
      ×
    </button>
  </div>
  <div
    data-testid="modal-content"
  >
    <div
      data-testid="audit-info"
    >
      <span
        data-testid="audit-url"
      >
        example.com
      </span>
      <span
        data-testid="audit-score"
      >
        Score: 
        85
        /100
      </span>
    </div>
    <div
      data-testid="visibility-section"
    >
      <span
        aria-live="polite"
        data-testid="visibility-status"
      >
        Private
      </span>
      <button
        aria-checked="false"
        aria-label="Toggle public visibility"
        data-testid="visibility-toggle"
        disabled=""
        role="switch"
      >
        OFF
      </button>
    </div>
    <div
      data-testid="loading-indicator"
    >
      <span>
        Loading...
      </span>
    </div>
  </div>
  <div
    data-testid="modal-footer"
  >
    <button
      data-testid="cancel-button"
    >
      Cancel
    </button>
  </div>
</div>
`;

