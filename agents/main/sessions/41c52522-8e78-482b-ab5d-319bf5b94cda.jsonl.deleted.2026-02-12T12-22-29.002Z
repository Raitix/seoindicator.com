{"type":"message","id":"124d2ce0","parentId":"8c29c97d","timestamp":"2026-02-12T11:22:10.772Z","message":{"role":"toolResult","toolCallId":"call_KmCElDqhJIQzk3Upxlh1P3SM|","toolName":"read","content":[{"type":"text","text":"const { test, expect } = require('@playwright/test');\r\n\r\ntest.describe('SEOIndicator.com Homepage', () => {\r\n  test('should have correct page title', async ({ page }) => {\r\n    // Navigate to the homepage\r\n    await page.goto('/');\r\n    \r\n    // Wait for the page to load completely\r\n    await page.waitForLoadState('networkidle');\r\n    \r\n    // Check that the page title is correct\r\n    await expect(page).toHaveTitle('SEOIndicator.com - AI Powered SEO Analysis');\r\n  });\r\n\r\n  test('should load the homepage successfully', async ({ page }) => {\r\n    // Navigate to the homepage\r\n    const response = await page.goto('/');\r\n    \r\n    // Check that the page loads successfully (status 200)\r\n    expect(response.status()).toBe(200);\r\n    \r\n    // Wait for the page to load completely\r\n    await page.waitForLoadState('networkidle');\r\n    \r\n    // Check that the page title is present\r\n    await expect(page).toHaveTitle(/SEOIndicator.com/);\r\n  });\r\n\r\n  test('should show the updated main header', async ({ page }) => {\r\n    // Navigate to the homepage\r\n    await page.goto('/');\r\n\r\n    // Wait for the page to load completely\r\n    await page.waitForLoadState('networkidle');\r\n\r\n    // Check that the main header text is updated\r\n    const mainHeader = page.locator('h1.main-title');\r\n    await expect(mainHeader).toHaveText('AI Powered SEO Analysis XXX');\r\n  });\r\n\r\n  test('should have visible content on the page', async ({ page }) => {\r\n    // Navigate to the homepage\r\n    await page.goto('/');\r\n    \r\n    // Wait for the page to load\r\n    await page.waitForLoadState('networkidle');\r\n    \r\n    // Check that the page has some visible content\r\n    const body = page.locator('body');\r\n    await expect(body).toBeVisible();\r\n    \r\n    // Check that the page is not empty\r\n    const textContent = await body.textContent();\r\n    expect(textContent.length).toBeGreaterThan(0);\r\n  });\r\n});\r\n"}],"isError":false,"timestamp":1770895330769}}
