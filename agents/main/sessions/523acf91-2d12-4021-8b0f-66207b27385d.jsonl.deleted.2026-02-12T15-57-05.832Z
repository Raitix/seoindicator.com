{"type":"message","id":"dc4e06d7","parentId":"4900d138","timestamp":"2026-02-12T14:57:32.851Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_SH17OHlWeFbpBkgPnwOuxIiA","name":"write","arguments":{"path":"C:\\Users\\Raitis\\Desktop\\My WEB projects\\SEOIndicator-com\\Files-SEOIndicator-com\\src\\ai\\metaDescription.test.js","content":"const analyzeMetaDescription = require(\"./metaDescriptionAnalyzer\");\n\ndescribe(\"Meta Description Analyzer\", () => {\n  test(\"should correctly extract the meta description from valid HTML\", () => {\n    const html = `\n      <html>\n        <head>\n          <meta name=\"description\" content=\"This is a sample meta description.\">\n        </head>\n        <body></body>\n      </html>\n    `;\n\n    const result = analyzeMetaDescription(html);\n    expect(result.success).toBe(true);\n    expect(result.metaDescription).toBe(\"This is a sample meta description.\");\n  });\n\n  test(\"should return an error for pages without a meta description\", () => {\n    const html = `\n      <html>\n        <head></head>\n        <body></body>\n      </html>\n    `;\n\n    const result = analyzeMetaDescription(html);\n    expect(result.success).toBe(false);\n    expect(result.error).toBe(\"Meta description not found\");\n  });\n});"}}],"api":"openai-completions","provider":"github-copilot","model":"gpt-4o","usage":{"input":472,"output":289,"cacheRead":11520,"cacheWrite":0,"totalTokens":12281,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1770908248754}}
