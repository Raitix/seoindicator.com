avigate to the Meta Description Analyzer\r\ntests\\meta-description.test.js:8:    await page.click('text=Meta Description Analyzer');\r\ntests\\meta-description.test.js:10:    // Input meta description for analysis\r\ntests\\meta-description.test.js:11:    await page.fill('#meta-description-input', 'This is a sample meta description for\r\n SEO testing.');\r\ntests\\metaDescription.test.js:6:  test('Meta Description AI Analysis Validation', async ({ page }) => {\r\ntests\\MetaDescriptionComponent.test.js:7:  it(\"should render the meta description result when meta description exists\",\r\n () => {\r\ntests\\MetaDescriptionComponent.test.js:8:    render(<MetaDescriptionComponent metaDescription=\"This is a sample meta de\r\nscription.\" error={null} />);\r\ntests\\MetaDescriptionComponent.test.js:10:    const result = screen.getByText(/This is a sample meta description\\./i);\r\ntests\\MetaDescriptionComponent.test.js:15:    render(<MetaDescriptionComponent metaDescription={null} error=\"Meta descr\r\niption not found\" />);\r\ntests\\MetaDescriptionComponent.test.js:17:    const error = screen.getByText(/Meta description not found/i);\r\ntests\\metaDescriptionTest.js:2:const metaDescriptionAnalyzer = require('../src/modules/metaDescriptionAnalyzer'); // Hy\r\npothetical module path\r\ntests\\metaDescriptionTest.js:4:describe('Meta Description Analysis', function() {\r\ntests\\metaDescriptionTest.js:5:    it('should correctly analyze the presence of a meta description', function() {\r\ntests\\metaDescriptionTest.js:6:        const htmlSample = `<html><head><meta name='description' content='Sample meta de\r\nscription'></head><body></body></html>`;\r\ntests\\metaDescriptionTest.js:7:        const result = metaDescriptionAnalyzer.analyzeMetaDescription(htmlSample);\r\ntests\\metaDescriptionTest.js:10:        expect(result).to.have.property('content', 'Sample meta description');\r\ntests\\metaDescriptionTest.js:13:    it('should return false if meta description is missing', function() {\r\ntests\\metaDescriptionTest.js:15:        const result = metaDescriptionAnalyzer.analyzeMetaDescription(htmlSample);\r\ntests\\metaDescriptionTest.js:20:    it('should handle edge cases with empty content in meta description', function() {\r\ntests\\metaDescriptionTest.js:22:        const result = metaDescriptionAnalyzer.analyzeMetaDescription(htmlSample);\r\ntests\\metaDescriptionTest.js:28:    it('should handle multiple meta descriptions with priority to the first', function(\r\n) {\r\ntests\\metaDescriptionTest.js:30:        const result = metaDescriptionAnalyzer.analyzeMetaDescription(htmlSample);\r\ntests\\meta_description.test.js:1:// This suite tests functionality for Meta Description indicator expansion\r\ntests\\meta_description.test.js:5:test.describe('Meta Description Analysis', async () => {\r\ntests\\meta_description.test.js:6:  test('Check AI integration with meta description analysis results', async ({ page })\r\n => {\r\ntests\\meta_description.test.js:14:    // Fetch Meta Description Analysis Results\r\ntests\\meta_description.test.js:18:    // Ensure AI-generated meta description suggestion exists\r\ntests\\meta_description.test.js:21:    expect(generatedSuggestion).toContain('AI Analysis: Meta description covers keywo\r\nrds well. Suggestions follow ..etc');","cwd":"C:\\Users\\Raitis\\Desktop\\My WEB projects\\SEOIndicator-com\\Files-SEOIndicator-com"},"isError":false,"timestamp":1770913070024}}
