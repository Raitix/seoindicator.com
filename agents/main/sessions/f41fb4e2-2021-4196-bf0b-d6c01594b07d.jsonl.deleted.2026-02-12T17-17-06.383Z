{"type":"message","id":"6bcb3e3b","parentId":"a7caeee4","timestamp":"2026-02-12T16:17:56.268Z","message":{"role":"toolResult","toolCallId":"call_QfX8g2PQGfnhs15U9UY6Gllj|","toolName":"read","content":[{"type":"text","text":"function analyzeMetaDescription(description) {\n  if (!description) {\n    return 'Description is empty. Please provide a meta description.';\n  }\n\n  const length = description.length;\n\n  if (length < 50) {\n    return 'Meta description is too short. Add more content for better SEO.';\n  } else if (length > 160) {\n    return 'Meta description is too long. Reduce the length to be within 50-160 characters.';\n  }\n\n  return 'Your meta description length is perfect. Ensure it aligns with your page content.';\n}\n\nmodule.exports = analyzeMetaDescription;"}],"isError":false,"timestamp":1770913076265}}
