php:38:                    <h1 class=\"mb-4 main-title\">Meta Description SEO Guide</h1>\r\nseo-guides\\meta-description.php:43:                        <h2 class=\"card-title text-primary mb-3\">What is a Meta Desc\r\nription?</h2>\r\nseo-guides\\meta-description.php:45:                            A meta description is an HTML attribute that provides a \r\nbrief summary of a web page's content. It appears in search engine results pages (SERPs) below the title tag and URL, g\r\niving users a preview of what they can expect to find on your page. Meta descriptions are defined within the <code>&lt;\r\nhead&gt;</code> section of your HTML document.\r\nseo-guides\\meta-description.php:58:                        <h2 class=\"card-title text-success mb-3\">Why Meta Descriptio\r\nns Matter for SEO</h2>\r\nseo-guides\\meta-description.php:60:                            <li class=\"mb-2\">?? <strong>Click-Through Rate (CTR):</s\r\ntrong> Well-written meta descriptions significantly increase the likelihood users will click on your search result</li>\r\nseo-guides\\meta-description.php:72:                        <h2 class=\"card-title text-warning mb-3\">SEO Best Practices \r\nfor Meta Descriptions</h2>\r\nseo-guides\\meta-description.php:88:                                    <li>Keywords in meta descriptions get bolded in \r\nsearch results</li>\r\nseo-guides\\meta-description.php:120:                        <h2 class=\"card-title text-danger mb-3\">Common Meta Descrip\r\ntion Mistakes to Avoid</h2>\r\nseo-guides\\meta-description.php:131:                                    <li>Missing meta descriptions entirely</li>\r\nseo-guides\\meta-description.php:144:                                    <li>Every important page has a meta description\r\n</li>\r\nseo-guides\\meta-description.php:154:                        <h2 class=\"card-title text-info mb-3\">Meta Description Exam\r\nples</h2>\r\nseo-guides\\meta-description.php:190:                        <h2 class=\"card-title text-primary mb-3\">How SEOIndicator.c\r\nom Analyzes Meta Descriptions</h2>\r\nseo-guides\\meta-description.php:191:                        <p>Our AI-powered analysis evaluates your meta description \r\nfor:</p>\r\nseo-guides\\meta-description.php:193:                            <li><strong>Presence:</strong> Whether a meta descripti\r\non exists on your page</li>\r\nseo-guides\\meta-description.php:204:                            <p class=\"mb-0\">Think of your meta description as a min\r\ni-advertisement for your page. It should answer the question \"Why should I click on this result instead of the others?\"\r\n Focus on the unique value you provide and what users will gain by visiting your page.</p>\r\nseo-guides\\MetaDescriptionIndicator.php:6:class MetaDescriptionIndicator extends Indicator {\r\nseo-guides\\MetaDescriptionIndicator.php:8:        parent::__construct('Meta Description Indicator');\r\nseo-guides\\MetaDescriptionIndicator.php:12:        $metaDescription = $data['meta_description'] ?? '';\r\nseo-guides\\MetaDescriptionIndicator.php:13:        $length = strlen($metaDescription);\r\nseo-guides\\MetaDescriptionIndicator.php:19:            'details' => htmlspecialchars(substr($metaDescription, 0, 100)),\r\nseo-guides\\MetaDescriptionIndicator.php:20:            'suggestion' => 'Optimize the meta description to 120-160 charac\r\nters'\r\nseo-guides\\mobile-friendly.php:111:                                    <li><strong>Content Parity:</strong> Ensure mobi\r\nle + desktop have identical text, images, videos, page structure, meta titles and meta descriptions</li>\r\nseo-guides\\page-speed.php:290:                                    <li><strong>Meta Description:</strong> Availability a\r\nnd relevance</li>\r\nsrc\\meta-description-analyzer.js:1:function analyzeMetaDescription(description) {\r\nsrc\\meta-description-analyzer.js:3:    return 'Description is empty. Please provide a meta description.';\r\nsrc\\meta-description-analyzer.js:9:    return 'Meta description is too short. Add more content for better SEO.';\r\nsrc\\meta-description-analyzer.js:11:    return 'Meta description is too long. Reduce the length to be within 50-160 cha\r\nracters.';\r\nsrc\\meta-description-analyzer.js:14:  return 'Your meta description length is perfect. Ensure it aligns with your page \r\ncontent.';\r\nsrc\\meta-description-analyzer.js:17:module.exports = analyzeMetaDescription;\r\nsrc\\ai\\metaDescription.test.js:1:const analyzeMetaDescription = require(\"./metaDescriptionAnalyzer\");\r\nsrc\\ai\\metaDescription.test.js:3:describe(\"Meta Description Analyzer\", () => {\r\nsrc\\ai\\metaDescription.test.js:4:  test(\"should correctly extract the meta description from valid HTML\", () => {\r\nsrc\\ai\\metaDescription.test.js:8:          <meta name=\"description\" content=\"This is a sample meta description.\">\r\nsrc\\ai\\metaDescription.test.js:14:    const result = analyzeMetaDescription(html);\r\nsrc\\ai\\metaDescription.test.js:16:    expect(result.metaDescription).toBe(\"This is a sample meta description.\");\r\nsrc\\ai\\metaDescription.test.js:19:  test(\"should return an error for pages without a meta description\", () => {\r\nsrc\\ai\\metaDescription.test.js:27:    const result = analyzeMetaDescription(html);\r\nsrc\\ai\\metaDescription.test.js:29:    expect(result.error).toBe(\"Meta description not found\");\r\nsrc\\ai\\metaDescriptionAnalyzer.js:1:// Backend AI Analysis for Meta Descriptions\r\nsrc\\ai\\metaDescriptionAnalyzer.js:2:const analyzeMetaDescription = (pageHTML) => {\r\nsrc\\ai\\metaDescriptionAnalyzer.js:3:  const metaDescriptionRegex = /<meta\\s+name=[\"']description[\"']\\s+content=[\"']([^\"\r\n']+)[\"']/i;\r\nsrc\\ai\\metaDescriptionAnalyzer.js:4:  const match = pageHTML.match(metaDescriptionRegex);\r\nsrc\\ai\\metaDescriptionAnalyzer.js:7:    return { success: true, metaDescription: match[1] };\r\nsrc\\ai\\metaDescriptionAnalyzer.js:10:  return { success: false, error: \"Meta description not found\" };\r\nsrc\\ai\\metaDescriptionAnalyzer.js:13:module.exports = analyzeMetaDescription;\r\nsrc\\tests\\metaDescription.test.ts:1:# Adding test cases to existing test suite for Meta Description indicator functiona\r\nlity.\r\nsrc\\ui\\MetaDescriptionComponent.js:3:const MetaDescriptionComponent = ({ metaDescription, error }) => {\r\nsrc\\ui\\MetaDescriptionComponent.js:5:    <div className=\"meta-description-container\">\r\nsrc\\ui\\MetaDescriptionComponent.js:9:        <p className=\"meta-description-result\">{metaDescription}</p>\r\nsrc\\ui\\MetaDescriptionComponent.js:15:export default MetaDescriptionComponent;\r\ntests\\ai-meta-description.spec.js:1:// ai-meta-description.spec.js - Playwright test for Meta Description AI analysis\r\ntests\\ai-meta-description.spec.js:5:test.describe('Meta Description AI Analysis', () => {\r\ntests\\ai-meta-description.spec.js:6:  test('AI suggestion includes meta description analysis', async ({ page }) => {\r\ntests\\ai-meta-description.spec.js:16:    // Check meta description analysis result\r\ntests\\ai-meta-description.spec.js:17:    const metaDescriptionAI = await page.textContent('#meta-description-result .ai\r\n-suggestion');\r\ntests\\ai-meta-description.spec.js:18:    expect(metaDescriptionAI).not.toBe('');\r\ntests\\ai-meta-description.spec.js:19:    expect(metaDescriptionAI).toContain('AI:');\r\ntests\\ai-meta-description.spec.js:22:    const staticAnalysis = await page.textContent('#meta-description-result .stati\r\nc-analysis');\r\ntests\\ai-meta-description.spec.js:26:  test('Standard meta description issues are flagged', async ({ page }) => {\r\ntests\\ai-meta-description.spec.js:27:    // Trigger with invalid meta description\r\ntests\\ai-meta-description.spec.js:37:    const issues = await page.textContent('#meta-description-result .issues');\r\ntests\\meta-description-analyzer.unit.test.js:1:const analyzeMetaDescription = require('../src/meta-description-analyzer\r\n');\r\ntests\\meta-description-analyzer.unit.test.js:3:describe(