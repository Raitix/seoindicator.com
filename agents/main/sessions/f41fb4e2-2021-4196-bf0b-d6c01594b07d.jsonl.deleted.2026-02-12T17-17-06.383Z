{"type":"message","id":"db7f3b58","parentId":"1b7bdcdb","timestamp":"2026-02-12T16:17:53.461Z","message":{"role":"toolResult","toolCallId":"call_tA7tza7SPbPRMNxiINTJXJzN|","toolName":"read","content":[{"type":"text","text":"// Backend AI Analysis for Meta Descriptions\nconst analyzeMetaDescription = (pageHTML) => {\n  const metaDescriptionRegex = /<meta\\s+name=[\"']description[\"']\\s+content=[\"']([^\"']+)[\"']/i;\n  const match = pageHTML.match(metaDescriptionRegex);\n\n  if (match && match[1]) {\n    return { success: true, metaDescription: match[1] };\n  }\n\n  return { success: false, error: \"Meta description not found\" };\n};\n\nmodule.exports = analyzeMetaDescription;"}],"isError":false,"timestamp":1770913073458}}
