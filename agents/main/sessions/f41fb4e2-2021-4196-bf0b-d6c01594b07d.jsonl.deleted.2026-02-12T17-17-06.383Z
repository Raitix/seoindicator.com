lyzer.unit.test.js:53:28)\n\n  ● Meta Description AI Analyzer (edge cases + i18n + relevancy) › applies CJK length guidance for internationalized content\n\n    TypeError: Cannot read properties of undefined (reading 'language')\n\n    [0m [90m 69 |[39m     [36mconst[39m result [33m=[39m analyzeMetaDescription(html)[33m;[39m\n     [90m 70 |[39m\n    [31m[1m>[22m[39m[90m 71 |[39m     expect(result[33m.[39manalysis[33m.[39mlanguage[33m.[39misCJK)[33m.[39mtoBe([36mtrue[39m)[33m;[39m\n     [90m    |[39m                            [31m[1m^[22m[39m\n     [90m 72 |[39m     expect(result[33m.[39manalysis[33m.[39mlength[33m.[39mstatus)[33m.[39mtoBe([32m'optimal'[39m)[33m;[39m\n     [90m 73 |[39m   })[33m;[39m\n     [90m 74 |[39m[0m\n\n      at Object.language (src/ai/metaDescriptionAnalyzer.unit.test.js:71:28)\n\n  ● Meta Description AI Analyzer (edge cases + i18n + relevancy) › flags overly long descriptions\n\n    TypeError: Cannot read properties of undefined (reading 'length')\n\n    [0m [90m 83 |[39m     [36mconst[39m result [33m=[39m analyzeMetaDescription(html)[33m;[39m\n     [90m 84 |[39m\n    [31m[1m>[22m[39m[90m 85 |[39m     expect(result[33m.[39manalysis[33m.[39mlength[33m.[39mstatus)[33m.[39mtoBe([32m'too_long'[39m)[33m;[39m\n     [90m    |[39m                            [31m[1m^[22m[39m\n     [90m 86 |[39m     expect(result[33m.[39manalysis[33m.[39missues)[33m.[39mtoContain([32m'too_long'[39m)[33m;[39m\n     [90m 87 |[39m   })[33m;[39m\n     [90m 88 |[39m[0m\n\n      at Object.length (src/ai/metaDescriptionAnalyzer.unit.test.js:85:28)\n\n  ● Meta Description AI Analyzer (edge cases + i18n + relevancy) › scores relevancy based on overlap with title/body context\n\n    TypeError: Cannot read properties of undefined (reading 'relevancy')\n\n    [0m [90m 100 |[39m     [36mconst[39m result [33m=[39m analyzeMetaDescription(html)[33m;[39m\n     [90m 101 |[39m\n    [31m[1m>[22m[39m[90m 102 |[39m     expect(result[33m.[39manalysis[33m.[39mrelevancy[33m.[39mscore)[33m.[39mtoBeGreaterThan([35m0.3[39m)[33m;[39m\n     [90m     |[39m                            [31m[1m^[22m[39m\n     [90m 103 |[39m     expect(result[33m.[39manalysis[33m.[39mrelevancy[33m.[39mstatus)[33m.[39mtoBe([32m'good'[39m)[33m;[39m\n     [90m 104 |[39m   })[33m;[39m\n     [90m 105 |[39m[0m\n\n      at Object.relevancy (src/ai/metaDescriptionAnalyzer.unit.test.js:102:28)\n\n  ● Meta Description AI Analyzer (edge cases + i18n + relevancy) › flags descriptions that duplicate the title\n\n    TypeError: Cannot read properties of undefined (reading 'issues')\n\n    [0m [90m 114 |[39m     [36mconst[39m result [33m=[39m analyzeMetaDescription(html)[33m;[39m\n     [90m 115 |[39m\n    [31m[1m>[22m[39m[90m 116 |[39m     expect(result[33m.[39manalysis[33m.[39missues)[33m.[39mtoContain([32m'duplicate_title'[39m)[33m;[39m\n     [90m     |[39m                            [31m[1m^[22m[39m\n     [90m 117 |[39m   })[33m;[39m\n     [90m 118 |[39m })[33m;[39m\n     [90m 119 |[39m[0m\n\n      at Object.issues (src/ai/metaDescriptionAnalyzer.unit.test.js:116:28)\n\nTest Suites: 1 failed, 1 total\nTests:       7 failed, 1 passed, 8 total\nSnapshots:   0 total\nTime:        0.97 s\nRan all test suites matching /src\\\\ai\\\\metaDescriptionAnalyzer.unit.test.js/i.\n\nCommand exited with code 1"},"isError":false,"timestamp":1770913490545}}
{"type":"message","id":"8ebfca47","parentId":"84e12d4e","timestamp":"2026-02-12T16:24:53.719Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Starting implementation after test run**","thinkingSignature":"{\"encrypted_content\":\"\",\"id\":\"\",\"summary\":[{\"text\":\"**Starting implementation after test run**\",\"type\":\"summary_text\"}],\"type\":\"reasoning\"}"},{"type":"toolCall","id":"call_NQb91UoSvpZiz35mU7RRlzMx|","name":"read","arguments":{"path":"C:\\Users\\Raitis\\Desktop\\My WEB projects\\SEOIndicator-com\\Files-SEOIndicator-com\\src\\ai\\metaDescriptionAnalyzer.js"},"partialJson":"{\"path\":\"C:\\\\Users\\\\Raitis\\\\Desktop\\\\My WEB projects\\\\SEOIndicator-com\\\\Files-SEOIndicator-com\\\\src\\\\ai\\\\metaDescriptionAnalyzer.js\"}"}],"api":"openai-responses","provider":"github-copilot","model":"gpt-5.2-codex","usage":{"input":2978,"output":94,"cacheRead":202368,"cacheWrite":0,"totalTokens":205440,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1770913490551}}
{"type":"message","id":"8eef69f6","parentId":"8ebfca47","timestamp":"2026-02-12T16:24:53.747Z","message":{"role":"toolResult","toolCallId":"call_NQb91UoSvpZiz35mU7RRlzMx|","toolName":"read","content":[{"type":"text","text":"// Backend AI Analysis for Meta Descriptions\nconst analyzeMetaDescription = (pageHTML) => {\n  const metaDescriptionRegex = /<meta\\s+name=[\"']description[\"']\\s+content=[\"']([^\"']+)[\"']/i;\n  const match = pageHTML.match(metaDescriptionRegex);\n\n  if (match && match[1]) {\n    return { success: true, metaDescription: match[1] };\n  }\n\n  return { success: false, error: \"Meta description not found\" };\n};\n\nmodule.exports = analyzeMetaDescription;"}],"isError":false,"timestamp":1770913493742}}
{"type":"message","id":"67708600","parentId":"8eef69f6","timestamp":"2026-02-12T16:26:23.979Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Planning core text extraction functions**\n\nI'm outlining the main functions needed for HTML text processing and analysis to replace the old implementation, focusing on careful, bug-free coding of decoding, normalization, tag stripping, metadata extraction, language/script detection, grapheme counting, tokenization, and relevance scoring.\n\n**Detailing full text extraction and analysis plan**\n\nThe plan details robust parsing of meta tags, title, headings, body text, language, and script detection, plus token extraction with stopword filtering and CJK awareness. It also outlines length evaluation, relevance scoring, duplicate detection, and AI-style summary generation for meta descriptions, emphasizing careful handling of HTML input and prioritization rules. Next step is implementing the full code based on this thorough pseudo blueprint.","thinkingSignature":"{\"encrypted_content\":\"\",\"id\":\"\",\"summary\":[{\"text\":\"**Planning core text extraction functions**\\n\\nI'm outlining the main functions needed for HTML text processing and analysis to replace the old implementation, focusing on careful, bug-free coding of decoding, normalization, tag stripping, metadata extraction, language/script detection, grapheme counting, tokenization, and relevance scoring.\",\"type\":\"summary_text\"},{\"text\":\"**Detailing full text extraction and analysis plan**\\n\\nThe plan details robust parsing of meta tags, title, headings, body text, language, and script detection, plus token extraction with stopword filtering and CJK awareness. It also outlines length evaluation, relevance scoring, duplicate detection, and AI-style summary generation for meta descriptions, emphasizing careful handling of HTML input and prioritization rules. Next step is implementing the full code based on this thorough pseudo blueprint.\",\"type\":\"summary_text\"}],\"type\":\"reasoning\"}"},{"type":"toolCall","id":"call_GMPSIcYmCVDTQEI4pO2b4TAp|","name":"write","arguments":{"path":"C:\\Users\\Raitis\\Desktop\\My WEB projects\\SEOIndicator-com\\Files-SEOIndicator-com\\src\\ai\\metaDescriptionAnalyzer.js","content":"const DEFAULT_LENGTH_RULES = { min: 50, max: 160, idealMin: 120, idealMax: 160 };\nconst CJK_LENGTH_RULES = { min: 40, max: 120, idealMin: 60, idealMax: 110 };\nconst THAI_LENGTH_RULES = { min: 40, max: 120, idealMin: 60, idealMax: 110 };\n\nconst STOPWORDS = new Set([\n  'the', 'and', 'for', 'to', 'of', 'in', 'a', 'an', 'is', 'with', 'on', 'your', 'our',\n  'you', 'this', 'that', 'from', 'by', 'be', 'or', 'as', 'at', 'it', 'its', 'are',\n  'about', 'into', 'over', 'under', 'within', 'without', 'best', 'guide'\n]);\n\nconst normalizeWhitespace = (text) => text.replace(/\\s+/g, ' ').trim();\n\nconst decodeHtmlEntities = (text) => {\n  if (!text) return '';\n  return text\n    .replace(/&nbsp;/gi, ' ')\n    .replace(/&amp;/gi, '&')\n    .replace(/&lt;/gi, '<')\n    .replace(/&gt;/gi, '>')\n    .replace(/&quot;/gi, '\"')\n    .replace(/&#39;/gi, \"'\")\n    .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCodePoint(parseInt(hex, 16)))\n    .replace(/&#(\\d+);/g, (_, num) => String.fromCodePoint(parseInt(num, 10)));\n};\n\nconst stripTags = (html) => html.replace(/<[^>]*>/g, ' ');\n\nconst parseMetaTags = (html) => {\n  const tags = [];\n  const metaRegex = /<meta\\b[^>]*>/gi;\n  let match;\n  while ((match = metaRegex.exec(html)) !== null) {\n    const tag = match[0];\n    const attrs = {};\n    const attrRegex = /([^\\s=]+)\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s\"'=<>`]+))/g;\n    let attrMatch;\n    while ((attrMatch = attrRegex.exec(tag)) !== null) {\n      const key = attrMatch[1].toLowerCase();\n      const value = attrMatch[2] ?? attrMatch[3] ?? attrMatch[4] ?? '';\n      attrs[key] = value;\n    }\n    tags.push(attrs);\n  }\n  return tags;\n};\n\nconst extractMetaDescription = (html) => {\n  const metaTags = parseMetaTags(html);\n  const candidates = [];\n\n  metaTags.forEach((attrs, index) => {\n    const name = (attrs.name || '').toLowerCase();\n    const property = (attrs.property || '').toLowerCase();\n    const itemprop = (attrs.itemprop || '').toLowerCase();\n    const content = attrs.content ?? '';\n\n    const matches = [\n      { match: name === 'description', source: 'meta[name=description]', priority: 1 },\n      { match: itemprop === 'description', source: 'meta[itemprop=description]', priority: 2 },\n      { match: property === 'description', source: 'meta[property=description]', priority: 3 },\n      { match: property === 'og:description', source: 'meta[property=og:description]', priority: 4 },\n      { match: name === 'twitter:description', source: 'meta[name=twitter:description]', priority: 5 },\n    ];\n\n    for (const entry of matches) {\n      if (entry.match) {\n        candidates.push({\n          content,\n          source: entry.source,\n          priority: entry.priority,\n          index,\n        });\n        break;\n      }\n    }\n  });\n\n  if (!candidates.length) {\n    return { found: false, content: '', source: null, candidates: [] };\n  }\n\n  candidates.sort((a, b) => a.priority - b.priority || a.index - b.index);\n  const chosen = candidates[0];\n\n  return {\n    found: true,\n    content: chosen.content ?? '',\n    source: chosen.source,\n    candidates: candidates.map((candidate) => ({\n      content: candidate.content ?? '',\n      source: candidate.source,\n    })),\n  };\n};\n\nconst extractTitle = (html) => {\n  const match = html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i);\n  if (!match) return '';\n  return normalizeWhitespace(decodeHtmlEntities(stripTags(match[1])));\n};\n\nconst extractH1 = (html) => {\n  const match = html.match(/<h1[^>]*>([\\s\\S]*?)<\\/h1>/i);\n  if (!match) return '';\n  return normalizeWhitespace(decodeHtmlEntities(stripTags(match[1])));\n};\n\nconst extractBodyText = (html) => {\n  const cleaned = html\n    .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, ' ');\n  return normalizeWhitespace(decodeHtmlEntities(stripTags(cleaned)));\n};\n\nconst extractLanguage = (html, metaTags) => {\n  const htmlLang = html.match(/<html[^>]*\\blang=[\"']?([^\"'\\s>]+)/i);\n  if (htmlLang && htmlLang[1]) {\n    return { lang: htmlLang[1].toLowerCase(), source: 'html' };\n  }\n\n  for (const attrs of metaTags) {\n    const httpEquiv = (attrs['http-equiv'] || '').toLowerCase();\n    const name = (attrs.name || '').toLowerCase();\n    if (httpEquiv === 'content-language' || httpEquiv === 'contentlanguage' || name === 'language' || name === 'content-language') {\n      const content = (attrs.content || '').split(/[,;]+/)[0].trim();\n      if (content) {\n        return { lang: content.toLowerCase(), source: 'meta' };\n      }\n    }\n  }\n\n  return { lang: 'und', source: 'unknown' };\n};\n\nconst detectScript = (text) => {\n  const hasCJK = /[\\u3040-\\u30ff\\u3400-\\u9fff\\uac00-\\ud7af]/.test(text);\n  if (hasCJK) return 'cjk';\n  if (/[\\u0e00-\\u0e7f]/.test(text)) return 'thai';\n  if (/[\\u0600-\\u06ff]/.test(text)) return 'arabic';\n  if (/[\\u0400-\\u04ff]/.test(text)) return 'cyrillic';\n  return 'latin';\n};\n\nconst countGraphemes = (text) => {\n  if (typeof Intl !== 'undefined' && Intl.Segmenter) {\n    const segmenter = new Intl.Segmenter('und', { granularity: 'grapheme' });\n    return Array.from(segmenter.segment(text)).length;\n  }\n  return Array.from(text).length;\n};\n\nconst getLengthRules = ({ isCJK, script }) => {\n  if (isCJK) return CJK_LENGTH_RULES;\n  if (script === 'thai') return THAI_LENGTH_RULES;\n  return DEFAULT_LENGTH_RULES;\n};\n\nconst evaluateLength = (description, rules) => {\n  const length = countGraphemes(description);\n  if (length === 0) {\n    return { value: length, ...rules, status: 'empty' };\n  }\n  if (length < rules.min) {\n    return { value: length, ...rules, status: 'too_short' };\n  }\n  if (length > rules.max) {\n    return { value: length, ...rules, status: 'too_long' };\n  }\n  if (length >= rules.idealMin && length <= rules.idealMax) {\n    return { value: length, ...rules, status: 'optimal' };\n  }\n  return { value: length, ...rules, status: 'acceptable' };\n};\n\nconst normalizeForCompare = (text) =>\n  normalizeWhitespace(text.toLowerCase().replace(/[\\p{P}\\p{S}]+/gu, ' '));\n\nconst extractTokens = (text, { isCJK }) => {\n  if (!text) return [];\n  const normalized = text.toLowerCase();\n\n  if (isCJK) {\n    const segmenter = typeof Intl !== 'undefined' && Intl.Segmenter\n      ? new Intl.Segmenter('und', { granularity: 'grapheme' })\n      : null;\n    const graphemes = segmenter\n      ? Array.from(segmenter.segment(normalized), (seg) => seg.segment)\n      : Array.from(normalized);\n    const cleaned = graphemes.filter((char) => /[\\p{L}\\p{N}]/u.test(char));\n    if (cleaned.length < 2) return cleaned;\n    const bigrams = [];\n    for (let i = 0; i < cleaned.length - 1; i += 1) {\n      bigrams.push(cleaned[i] + cleaned[i + 1]);\n    }\n    return bigrams;\n  }\n\n  const matches = normalized.match(/[\\p{L}\\p{N}]{2,}/gu) || [];\n  return matches.filter((token) => !STOPWORDS.has(token));\n};\n\nconst computeJaccard = (aTokens, bTokens) => {\n  const aSet = new Set(aTokens);\n  const bSet = new Set(bTokens);\n  if (!aSet.size || !bSet.size) return 0;\n  let intersection = 0;\n  for (const token of aSet) {\n    if (bSet.has(token)) intersection += 1;\n  }\n  const union = aSet.size + bSet.size - intersection;\n  return union === 0 ? 0 : intersection / union;\n};\n\nconst getTopTokens = (tokens, max = 5) => {\n  const counts = tokens.reduce((acc, token) => {\n    acc[token] = (acc[token] || 0) + 1;\n    return acc;\n  }, {});\n\n  return Object.entries(counts)\n    .sort((a, b) => b[1] - a[1])\n    .slice(0, max)\n    .map(([token]) => token);\n};\n\nconst computeRelevancy = (description, contextText, isCJK) => {\n  const descTokens = extractTokens(description, { isCJK });\n  const contextTokens = extractTokens(contextText, { isCJK });\n\n  if (!descTokens.length || !contextTokens.length) {\n    return {\n      score: 0,\n      status: 'low',\n      overlap: [],\n      contextTopTokens: getTopTokens(contextTokens, 5),\n    };\n  }\n\n  const contextSet = new Set(contextTokens);\n  const overlap = descTokens.filter((token) => contextSet.has(token));\n  const score = overlap.length / descTokens.length;\n\n  let status = 'low';\n  if (score >= 0.4) status = 'good';\n  else if (score >= 0.2) status = 'medium';\n\n  return {\n    score,\n    status,\n    overlap,\n    contextTopTokens: getTopTokens(contextTokens, 5),\n  };\n};\n\nconst analyzeMetaDescription = (pageHTML = '') => {\n  const html = typeof pageHTML === 'string' ? pageHTML : '';\n  const metaTags = parseMetaTags(html);\n  const extraction = extractMetaDescription(html);\n\n  if (!extraction.found) {\n    return {\n      success: false,\n      error: 'Meta description not found',\n      analysis: {\n        issues: ['missing'],\n        length: evaluateLength('', DEFAULT_LENGTH_RULES),\n        language: { lang: 'und', script: 'latin', isCJK: false },\n        relevancy: { score: 0, status: 'low', overlap: [], contextTopTokens: [] },\n        source: null,\n        candidates: [],\n        suggestions: ['Add a unique meta description that summarizes the page value in 50-160 characters.'],\n        aiSummary: 'AI Analysis: Meta description missing. Add a concise summary that matches the page content.',\n      },\n    };\n  }\n\n  const title = extractTitle(html);\n  const h1 = extractH1(html);\n  const bodyText = extractBodyText(html);\n  const language = extractLanguage(html, metaTags);\n\n  const rawDescription = extraction.content ?? '';\n  const cleanedDescription = normalizeWhitespace(decodeHtmlEntities(rawDescription));\n\n  const script = detectScript(cleanedDescription || title || bodyText);\n  const isCJK = script === 'cjk' || ['zh', 'ja', 'ko'].some((prefix) => language.lang.startsWith(prefix));\n  const lengthRules = getLengthRules({ isCJK, script });\n  const lengthInfo = evaluateLength(cleanedDescription, lengthRules);\n\n  const contextText = normalizeWhitespace([title, h1, bodyText].filter(Boolean).join(' '));\n  const relevancy = computeRelevancy(cleanedDescription, contextText, isCJK);\n\n  const issues = [];\n  if (lengthInfo.status === 'empty') issues.push('empty');\n  if (lengthInfo.status === 'too_short') issues.push('too_short');\n  if (lengthInfo.status === 'too_long') issues.push('too_long');\n  if (relevancy.status === 'low') issues.push('low_relevance');\n\n  const normalizedDesc = normalizeForCompare(cleanedDescription);\n  const normalizedTitle = normalizeForCompare(title);\n  const duplicateTitle = normalizedDesc && normalizedTitle\n    ? normalizedDesc === normalizedTitle\n    : false;\n  if (duplicateTitle) issues.push('duplicate_title');\n\n  const descTokens = extractTokens(cleanedDescription, { isCJK });\n  const uniqueTokens = new Set(descTokens);\n  if (descTokens.length >= 6) {\n    const topToken = getTopTokens(descTokens, 1)[0];\n    const topTokenCount = descTokens.filter((token) => token === topToken).length;\n    if (topTokenCount / descTokens.length > 0.3 || uniqueTokens.size / descTokens.length < 0.6) {\n      issues.push('keyword_stuffing');\n    }\n  }\n\n  const suggestions = [];\n  if (issues.includes('empty') || issues.includes('too_short')) {\n    suggestions.push(`Expand the description to at least ${lengthRules.min} characters and highlight the main benefit.`);\n  }\n  if (issues.includes('too_long')) {\n    suggestions.push(`Trim the description to ${lengthRules.max} characters or fewer to avoid truncation.`);\n  }\n  if (issues.includes('duplicate_title')) {\n    suggestions.push('Avoid duplicating the title. Add a unique value proposition or call-to-action.');\n  }\n  if (issues.includes('low_relevance') && relevancy.contextTopTokens.length) {\n    suggestions.push(`Align the description with the page topic. Consider including: ${relevancy.contextTopTokens.join(', ')}.`);\n  } else if (issues.includes('low_relevance')) {\n    suggestions.push('Align the description with the primary topic of the page content.');\n  }\n  if (issues.includes('keyword_stuffing')) {\n    suggestions.push('Reduce repeated terms and keep the phrasing natural.');\n  }\n  if (!suggestions.length && lengthInfo.status === 'acceptable') {\n    suggestions.push(`Aim for the ideal range of ${lengthRules.idealMin}-${lengthRules.idealMax} characters for stronger SERP visibility.`);\n  }\n\n  const lengthSummary = lengthInfo.status === 'optimal'\n    ? `Length is optimal (${lengthInfo.value} chars; target ${lengthRules.min}-${lengthRules.max}).`\n    : `Length is ${lengthInfo.status.replace('_', ' ')} (${lengthInfo.value} chars; target ${lengthRules.min}-${lengthRules.max}).`;\n  const relevanceSummary = `Relevance is ${relevancy.status} (score ${(relevancy.score * 100).toFixed(0)}%).`;\n  const issueSummary = issues.length ? `Issues: ${issues.join(', ')}.` : 'No critical issues found.';\n\n  return {\n    success: true,\n    metaDescription: cleanedDescription,\n    analysis: {\n      length: lengthInfo,\n      language: {\n        lang: language.lang,\n        script,\n        isCJK,\n        source: language.source,\n      },\n      relevancy,\n      issues,\n      suggestions,\n      source: extraction.source,\n      candidates: extraction.candidates,\n      aiSummary: `AI Analysis: ${lengthSummary} ${relevanceSummary} ${issueSummary}`,\n    },\n  };\n};\n\nmodule.exports = analyzeMetaDescription;\n"},"partialJson":"{\"path\":\"C:\\\\Users\\\\Raitis\\\\Desktop\\\\My WEB projects\\\\SEOIndicator-com\\\\Files-SEOIndicator-com\\\\src\\\\ai\\\\metaDescriptionAnalyzer.js\",\"content\":\"const DEFAULT_LENGTH_RULES = { min: 50, max: 160, idealMin: 120, idealMax: 160 };\\nconst CJK_LENGTH_RULES = { min: 40, max: 120, idealMin: 60, idealMax: 110 };\\nconst THAI_LENGTH_RULES = { min: 40, max: 120, idealMin: 60, idealMax: 110 };\\n\\nconst STOPWORDS = new Set([\\n  'the', 'and', 'for', 'to', 'of', 'in', 'a', 'an', 'is', 'with', 'on', 'your', 'our',\\n  'you', 'this', 'that', 'from', 'by', 'be', 'or', 'as', 'at', 'it', 'its', 'are',\\n  'about', 'into', 'over', 'under', 'within', 'without', 'best', 'guide'\\n]);\\n\\nconst normalizeWhitespace = (text) => text.replace(/\\\\s+/g, ' ').trim();\\n\\nconst decodeHtmlEntities = (text) => {\\n  if (!text) return '';\\n  return text\\n    .replace(/&nbsp;/gi, ' ')\\n    .replace(/&amp;/gi, '&')\\n    .replace(/&lt;/gi, '<')\\n    .replace(/&gt;/gi, '>')\\n    .replace(/&quot;/gi, '\\\"')\\n    .replace(/&#39;/gi, \\\"'\\\")\\n    .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCodePoint(parseInt(hex, 16)))\\n    .replace(/&#(\\\\d+);/g, (_, num) => String.fromCodePoint(parseInt(num, 10)));\\n};\\n\\nconst stripTags = (html) => html.replace(/<[^>]*>/g, ' ');\\n\\nconst parseMetaTags = (html) => {\\n  const tags = [];\\n  const metaRegex = /<meta\\\\b[^>]*>/gi;\\n  let match;\\n  while ((match = metaRegex.exec(html)) !== null) {\\n    const tag = match[0];\\n    const attrs = {};\\n    const attrRegex = /([^\\\\s=]+)\\\\s*=\\\\s*(?:\\\"([^\\\"]*)\\\"|'([^']*)'|([^\\\\s\\\"'=<>`]+))/g;\\n    let attrMatch;\\n    while ((attrMatch = attrRegex.exec(tag)) !== null) {\\n      const key = attrMatch[1].toLowerCase();\\n      const value = attrMatch[2] ?? attrMatch[3] ?? attrMatch[4] ?? '';\\n      attrs[key] = value;\\n    }\\n    tags.push(attrs);\\n  }\\n  return tags;\\n};\\n\\nconst extractMetaDescription = (html) => {\\n  const metaTags = parseMetaTags(html);\\n  const candidates = [];\\n\\n  metaTags.forEach((attrs, index) => {\\n    const name = (attrs.name || '').toLowerCase();\\n    const property = (attrs.property || '').toLowerCase();\\n    const itemprop = (attrs.itemprop || '').toLowerCase();\\n    const content = attrs.content ?? '';\\n\\n    const matches = [\\n      { match: name === 'description', source: 'meta[name=description]', priority: 1 },\\n      { match: itemprop === 'description', source: 'meta[itemprop=description]', priority: 2 },\\n      { match: property === 'description', source: 'meta[property=description]', priority: 3 },\\n      { match: property === 'og:description', source: 'meta[property=og:description]', priority: 4 },\\n      { match: name === 'twitter:description', source: 'meta[name=twitter:description]', priority: 5 },\\n    ];\\n\\n    for (const entry of matches) {\\n      if (entry.match) {\\n        candidates.push({\\n          content,\\n          source: entry.source,\\n          priority: entry.priority,\\n          index,\\n        });\\n        break;\\n      }\\n    }\\n  });\\n\\n  if (!candidates.length) {\\n    return { found: false, content: '', source: null, candidates: [] };\\n  }\\n\\n  candidates.sort((a, b) => a.priority - b.priority || a.index - b.index);\\n  const chosen = candidates[0];\\n\\n  return {\\n    found: true,\\n    content: chosen.content ?? '',\\n    source: chosen.source,\\n    candidates: candidates.map((candidate) => ({\\n      content: candidate.content ?? '',\\n      source: candidate.source,\\n    })),\\n  };\\n};\\n\\nconst extractTitle = (html) => {\\n  const match = html.match(/<title[^>]*>([\\\\s\\\\S]*?)<\\\\/title>/i);\\n  if (!match) return '';\\n  return normalizeWhitespace(decodeHtmlEntities(stripTags(match[1])));\\n};\\n\\nconst extractH1 = (html) => {\\n  const match = html.match(/<h1[^>]*>([\\\\s\\\\S]*?)<\\\\/h1>/i);\\n  if (!match) return '';\\n  return normalizeWhitespace(decodeHtmlEntities(stripTags(match[1])));\\n};\\n\\nconst extractBodyText = (html) => {\\n  const cleaned = html\\n    .replace(/<script[^>]*>[\\\\s\\\\S]*?<\\\\/script>/gi, ' ')\\n    .replace(/<style[^>]*>[\\\\s\\\\S]*?<\\\\/style>/gi, ' ');\\n  return normalizeWhitespace(decodeHtmlEntities(stripTags(cleaned)));\\n};\\n\\nconst extractLanguage = (html, metaTags) => {\\n  const htmlLang = html.match(/<html[^>]*\\\\blang=[\\\"']?([^\\\"'\\\\s>]+)/i);\\n  if (htmlLang && htmlLang[1]) {\\n    return { lang: htmlLang[1].toLowerCase(), source: 'html' };\\n  }\\n\\n  for (const attrs of metaTags) {\\n    const httpEquiv = (attrs['http-equiv'] || '').toLowerCase();\\n    const name = (attrs.name || '').toLowerCase();\\n    if (httpEquiv === 'content-language' || httpEquiv === 'contentlanguage' || name === 'language' || name === 'content-language') {\\n      const content = (attrs.content || '').split(/[,;]+/)[0].trim();\\n      if (content) {\\n        return { lang: content.toLowerCase(), source: 'meta' };\\n      }\\n    }\\n  }\\n\\n  return { lang: 'und', source: 'unknown' };\\n};\\n\\nconst detectScript = (text) => {\\n  const hasCJK = /[\\\\u3040-\\\\u30ff\\\\u3400-\\\\u9fff\\\\uac00-\\\\ud7af]/.test(text);\\n  if (hasCJK) return 'cjk';\\n  if (/[\\\\u0e00-\\\\u0e7f]/.test(text)) return 'thai';\\n  if (/[\\\\u0600-\\\\u06ff]/.test(text)) return 'arabic';\\n  if (/[\\\\u0400-\\\\u04ff]/.test(text)) return 'cyrillic';\\n  return 'latin';\\n};\\n\\nconst countGraphemes = (text) => {\\n  if (typeof Intl !== 'undefined' && Intl.Segmenter) {\\n    const segmenter = new Intl.Segmenter('und', { granularity: 'grapheme' });\\n    return Array.from(segmenter.segment(text)).length;\\n  }\\n  return Array.from(text).length;\\n};\\n\\nconst getLengthRules = ({ isCJK, script }) => {\\n  if (isCJK) return CJK_LENGTH_RULES;\\n  if (script === 'thai') return THAI_LENGTH_RULES;\\n  return DEFAULT_LENGTH_RULES;\\n};\\n\\nconst evaluateLength = (description, rules) => {\\n  const length = countGraphemes(description);\\n  if (length === 0) {\\n    return { value: length, ...rules, status: 'empty' };\\n  }\\n  if (length < rules.min) {\\n    return { value: length, ...rules, status: 'too_short' };\\n  }\\n  if (length > rules.max) {\\n    return { value: length, ...rules, status: 'too_long' };\\n  }\