<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route API requests to Laravel (backend/public)
    # Preserve full REQUEST_URI so Laravel sees /api/health, /api/v1/... correctly
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ backend/public/index.php [L]

    # Serve existing files/directories as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>
